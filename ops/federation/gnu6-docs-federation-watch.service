[Unit]
Description=GNU6 Docs Federation public GitHub watch (read only)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 %h/.local/share/gnu6-docs-federation/scripts/federation_vps_watch.py --registry %h/.local/share/gnu6-docs-federation/docs/federation/sources.v1.json --state %h/.local/state/gnu6-docs-federation
RuntimeMaxSec=90
MemoryHigh=64M
MemoryMax=96M
CPUQuota=35%
TasksMax=24
Nice=10
IOSchedulingClass=idle
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/.local/state/gnu6-docs-federation
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
UMask=0077
